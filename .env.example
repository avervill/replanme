# Shared local development
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/replanme
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser sessions and encrypted Google credentials
COOKIE_SECURE=false
TOKEN_ENCRYPTION_KEY=

# OpenAI (API service only)
OPENAI_API_KEY=
AI_SIMPLE_MODEL=gpt-5.6-luna
AI_COMPLEX_MODEL=gpt-5.6-terra
TRANSCRIPTION_MODEL=gpt-transcribe

# Google OAuth testing mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_ALLOWED_EMAILS=
